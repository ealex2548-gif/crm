PORT=3001
NODE_ENV=development

# Caminho do arquivo SQLite. Local: relativo a server/prisma/.
# Docker: sobrescrito no docker-compose.yml para /app/data/seucrm.db (volume persistente).
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (leave blank while WHATSAPP_PROVIDER=mock)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me

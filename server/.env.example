PORT=3001
NODE_ENV=development

# Overridden by docker-compose when running in containers
DATABASE_URL=postgresql://seucrm:seucrm@localhost:5432/seucrm
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (leave blank while WHATSAPP_PROVIDER=mock)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me

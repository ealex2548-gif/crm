PORT=3001
NODE_ENV=development

# Caminho do arquivo SQLite. Local: relativo a server/prisma/.
# Docker: sobrescrito no docker-compose.yml para /app/data/seucrm.db (volume persistente).
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# URL pública onde este backend é acessível (ex: https://seu-dominio.com ou
# http://SEU_IP:8080). Com a CoverCut a mídia é enviada por upload (media_id),
# então isso não precisa ser https.
PUBLIC_BASE_URL=http://localhost:3001

# WhatsApp: "mock" (padrão, não envia nada de verdade) ou "covercut" (BSP real)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me

# CoverCut (https://api.covercut.com.br) — só necessário com WHATSAPP_PROVIDER=covercut
COVERCUT_API_KEY=
COVERCUT_API_SECRET=
# Gerado pela CoverCut ao registrar o webhook (POST /api/v1/numbers/webhook) —
# usado para validar a assinatura X-BSP-Signature dos webhooks recebidos.
COVERCUT_WEBHOOK_SECRET=
# Só precisa preencher se houver mais de um número WhatsApp ativo na conta CoverCut.
COVERCUT_PHONE_NUMBER_ID=

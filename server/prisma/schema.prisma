generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não tem tipo enum nativo, então os campos abaixo marcados com
// "// enum:" são strings validadas pela aplicação (ver src/constants/enums.js),
// não pelo banco. Isso é o principal trade-off de usar SQLite aqui.

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("AGENT") // enum: ADMIN | SUPERVISOR | AGENT
  sector       Sector?   @relation(fields: [sectorId], references: [id])
  sectorId     String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedConversations Conversation[] @relation("AssignedAgent")
  ownedTickets          Ticket[]
  sentMessages          Message[]
  auditLogs             AuditLog[]
}

model Sector {
  id   String @id @default(cuid())
  name String @unique

  users         User[]
  contacts      Contact[]
  conversations Conversation[]
}

model Contact {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  company      String?
  city         String?
  plan         String?
  pdvVersion   String?
  pdvTerminals String?
  pdvDatabase  String?
  sector       Sector?  @relation(fields: [sectorId], references: [id])
  sectorId     String?
  createdAt    DateTime @default(now())

  conversations Conversation[]
  tickets       Ticket[]
}

model Conversation {
  id              String    @id @default(cuid())
  contact         Contact   @relation(fields: [contactId], references: [id])
  contactId       String
  sector          Sector?   @relation(fields: [sectorId], references: [id])
  sectorId        String?
  assignedAgent   User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  assignedAgentId String?
  priority        String    @default("NORMAL") // enum: BAIXA | NORMAL | ALTA | URGENTE
  status          String    @default("EM_ATENDIMENTO") // enum: EM_ATENDIMENTO | AGUARDANDO_CLIENTE | AGUARDANDO_EQUIPE | FINALIZADO
  createdAt       DateTime  @default(now())
  closedAt        DateTime?

  messages Message[]
  tickets  Ticket[]

  @@index([status])
  @@index([sectorId])
}

model Message {
  id                String    @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  conversationId    String
  direction         String    // enum: IN | OUT
  type              String    @default("TEXT") // enum: TEXT | NOTE | MEDIA
  body              String?
  mediaUrl          String?
  whatsappMessageId String?
  status            String    @default("SENT") // enum: PENDING | SENT | DELIVERED | READ | FAILED
  sentBy            User?     @relation(fields: [sentById], references: [id])
  sentById          String?
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([conversationId])
}

model Ticket {
  id             String        @id @default(cuid())
  contact        Contact       @relation(fields: [contactId], references: [id])
  contactId      String
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  title          String
  status         String        @default("NOVO") // enum: NOVO | EM_ATENDIMENTO | AGUARDANDO_CLIENTE | FINALIZADO
  priority       String        @default("NORMAL") // enum: BAIXA | NORMAL | ALTA | URGENTE
  owner          User?         @relation(fields: [ownerId], references: [id])
  ownerId        String?
  deadline       DateTime?
  createdAt      DateTime      @default(now())
  closedAt       DateTime?

  @@index([status])
}

model QuickReply {
  id       String @id @default(cuid())
  category String
  body     String
}

model KnowledgeArticle {
  id       String @id @default(cuid())
  category String
  title    String
  body     String
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON serializado (JSON.stringify) — SQLite não tem tipo Json nativo
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
